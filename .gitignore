# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
# test:coverage's report directory
coverage/
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Task state, but the lock: what the shared library's pin fetched, and its
# checksum (.task/remote), which every run loads instead of fetching
.task/*
!.task/remote/
.task/remote/*
!.task/remote/*.yaml
!.task/remote/*.checksum

# Release tooling (npm ci)
node_modules/
