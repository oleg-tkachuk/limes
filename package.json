{
  "name": "limes-release",
  "private": true,
  "description": "Release tooling only: semantic-release, run by .github/workflows/release.yaml.",
  "devDependencies": {
    "semantic-release": "25.0.9",
    "@semantic-release/commit-analyzer": "13.0.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "@semantic-release/npm": "file:scripts/release/unused-npm-plugin"
  },
  "overrides": {
    "@semantic-release/npm": "$@semantic-release/npm"
  }
}
