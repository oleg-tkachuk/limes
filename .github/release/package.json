{
  "name": "limes-release",
  "private": true,
  "description": "Release tooling only: semantic-release, run by .github/workflows/release.yaml.",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/npm": "file:unused-npm-plugin",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "semantic-release": "25.0.9",
    "conventional-changelog-writer": "9.3.0"
  },
  "overrides": {
    "@semantic-release/npm": "$@semantic-release/npm",
    "conventional-changelog-writer": "$conventional-changelog-writer"
  }
}
